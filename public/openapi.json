{
  "openapi": "3.1.1",
  "info": { "title": "Night Atlas API", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/nearby": {
      "get": {
        "summary": "Find the nearest catalog sites",
        "parameters": [
          { "name": "lat", "in": "query", "required": true, "description": "Latitude in degrees.", "schema": { "type": "number", "minimum": -90, "maximum": 90 } },
          { "name": "lon", "in": "query", "required": true, "description": "Longitude in degrees.", "schema": { "type": "number", "minimum": -180, "maximum": 180 } },
          { "name": "limit", "in": "query", "required": false, "description": "Maximum results; defaults to the current catalog size, which is also the upper bound.", "schema": { "type": "integer", "minimum": 1, "maximum": 6, "default": 6 } }
        ],
        "responses": {
          "200": { "description": "Sites sorted by ascending distance before rounding to whole kilometers.", "content": { "application/json": { "schema": {
            "type": "object", "required": ["sites"], "properties": { "sites": { "type": "array", "items": { "$ref": "#/components/schemas/NearbySite" } } }
          } } } },
          "400": { "description": "Missing or invalid coordinates, invalid limit, or repeated or unknown query parameter.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/sites": {
      "get": {
        "summary": "List or export a filtered page of sites",
        "description": "JSON by default. Send Accept: text/csv to select CSV; the entire header must equal text/csv ignoring case. Lists and quality values do not select CSV. The view parameter only changes JSON fields.",
        "parameters": [
          { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/CatalogRegion" },
          { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" },
          { "$ref": "#/components/parameters/View" }, { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": {
            "description": "Matching page in catalog order, possibly empty.",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Vary": { "$ref": "#/components/headers/Vary" }, "X-Total-Count": { "$ref": "#/components/headers/Total" }, "Link": { "$ref": "#/components/headers/Next" } },
            "content": {
              "application/json": { "schema": { "type": "object", "required": ["sites"], "properties": { "sites": { "type": "array", "items": { "oneOf": [{ "$ref": "#/components/schemas/Site" }, { "$ref": "#/components/schemas/SiteSummary" }] } } } } },
              "text/csv": { "schema": { "$ref": "#/components/schemas/SitesCsv" } }
            }
          },
          "304": { "description": "The selected representation matches If-None-Match. No body.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Vary": { "$ref": "#/components/headers/Vary" }, "X-Total-Count": { "$ref": "#/components/headers/Total" }, "Link": { "$ref": "#/components/headers/Next" } } },
          "400": { "description": "Invalid filter or repeated or unknown query parameter; always JSON, even when CSV is requested.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "head": {
        "summary": "Inspect catalog page headers without downloading the page",
        "description": "Uses the same validation and negotiation as GET. Content-Type is text/csv; charset=utf-8 when Accept equals text/csv ignoring case, and application/json otherwise or on invalid input.",
        "parameters": [
          { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/CatalogRegion" },
          { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" },
          { "$ref": "#/components/parameters/View" }, { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": { "description": "Headers for the selected catalog page. No body.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Vary": { "$ref": "#/components/headers/Vary" }, "X-Total-Count": { "$ref": "#/components/headers/Total" }, "Link": { "$ref": "#/components/headers/Next" } } },
          "304": { "description": "The selected representation matches If-None-Match. No body.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Vary": { "$ref": "#/components/headers/Vary" }, "X-Total-Count": { "$ref": "#/components/headers/Total" }, "Link": { "$ref": "#/components/headers/Next" } } },
          "400": { "description": "Invalid filter or repeated or unknown query parameter. No body." }
        }
      }
    },
    "/api/sites.csv": {
      "get": {
        "summary": "Download the catalog as CSV",
        "parameters": [{ "$ref": "#/components/parameters/ExportRegion" }],
        "responses": { "200": {
          "description": "CSV attachment, with a header row even when no sites match.",
          "headers": { "Content-Disposition": { "schema": { "type": "string", "const": "attachment; filename=\"sites.csv\"" } } },
          "content": { "text/csv": { "schema": { "$ref": "#/components/schemas/SitesCsv" } } }
        } }
      }
    },
    "/api/sites.geojson": {
      "get": {
        "summary": "Export catalog viewing spots as GeoJSON points",
        "parameters": [{ "$ref": "#/components/parameters/ExportRegion" }],
        "responses": { "200": { "description": "Feature collection, with an empty features array when no sites match.", "content": { "application/geo+json": { "schema": { "$ref": "#/components/schemas/FeatureCollection" } } } } }
      }
    },
    "/api/sites/exports": {
      "get": {
        "summary": "Discover catalog export formats",
        "responses": { "200": { "description": "Available formats with their API paths and media types.", "content": { "application/json": { "schema": {
          "type": "object", "required": ["catalog", "formats"], "properties": {
            "catalog": { "const": "night-atlas" },
            "formats": { "type": "array", "items": { "type": "object", "required": ["id", "path", "media_type"], "properties": {
              "id": { "type": "string", "enum": ["json", "csv", "geojson"] },
              "path": { "type": "string", "format": "uri-reference" },
              "media_type": { "type": "string", "enum": ["application/json", "text/csv", "application/geo+json"] }
            } } }
          }
        } } } } }
      }
    },
    "/api/sites/status": {
      "get": {
        "summary": "Read the current catalog status",
        "responses": { "200": { "description": "Catalog identifier, site count, and timestamp generated for this request.", "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } }, "content": { "application/json": { "schema": {
          "type": "object", "required": ["catalog", "site_count", "generated_at"], "properties": {
            "catalog": { "const": "night-atlas" }, "site_count": { "type": "integer", "minimum": 0 }, "generated_at": { "type": "string", "format": "date-time" }
          }
        } } } } }
      }
    },
    "/api/sites/summary": {
      "get": {
        "summary": "Count matching sites by state and region",
        "parameters": [
          { "$ref": "#/components/parameters/Search" },
          { "name": "state", "in": "query", "required": false, "description": "Exact case-sensitive state name. Unknown or empty values match no sites.", "schema": { "type": "string" } },
          { "name": "region", "in": "query", "required": false, "description": "Exact case-sensitive catalog region.", "schema": { "$ref": "#/components/schemas/Region" } }
        ],
        "responses": {
          "200": { "description": "Counts from the intersection of the supplied filters. No matches yield zero and empty count maps.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogSummary" } } } },
          "400": { "description": "Repeated filter, unknown query parameter, invalid region, or search text exceeding the limit.", "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FilterError" } } } }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Search": { "name": "q", "in": "query", "required": false, "description": "Trimmed search text (up to 80 characters after trimming). Each whitespace-separated word must match a substring in name, state or viewpoint, ignoring case. Empty text adds no restriction.", "schema": { "type": "string", "pattern": "^\\s*(?:\\S(?:[\\s\\S]{0,78}\\S)?)?\\s*$" } },
      "CatalogRegion": { "name": "region", "in": "query", "required": false, "description": "West, Southwest or Northeast, ignoring case and outer whitespace. Empty or unmatched values are invalid.", "schema": { "type": "string", "pattern": "^\\s*(?:[Ww][Ee][Ss][Tt]|[Ss][Oo][Uu][Tt][Hh][Ww][Ee][Ss][Tt]|[Nn][Oo][Rr][Tt][Hh][Ee][Aa][Ss][Tt])\\s*$" } },
      "ExportRegion": { "name": "region", "in": "query", "required": false, "style": "form", "explode": true, "description": "One occurrence filters by region ignoring case and outer whitespace; an empty or unmatched value returns no sites. Omission or multiple occurrences return the full catalog. Other query parameters are ignored.", "schema": { "type": "array", "items": { "type": "string" } }, "example": ["West"] },
      "Limit": { "name": "limit", "in": "query", "required": false, "description": "Maximum page size, written as decimal digits without leading zeros. Omit to return all remaining matches.", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
      "Offset": { "name": "offset", "in": "query", "required": false, "description": "Number of matching sites to skip, written as unsigned decimal digits.", "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0 } },
      "View": { "name": "view", "in": "query", "required": false, "description": "Use summary to omit description and notes from JSON records. Omit for full records.", "schema": { "type": "string", "const": "summary" } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "description": "Use * or a comma-separated entity-tag list. A weak comparison against the selected representation determines whether to return 304.", "schema": { "type": "string" } }
    },
    "headers": {
      "ETag": { "description": "Weak validator for the selected response bytes.", "schema": { "type": "string" } },
      "Vary": { "schema": { "type": "string", "const": "Accept" } },
      "Total": { "description": "Total matching sites before pagination.", "schema": { "type": "integer", "minimum": 0 } },
      "Next": { "description": "Relative next-page link with rel=next, present only when a limit was supplied and more matches remain.", "schema": { "type": "string" } },
      "NoStore": { "schema": { "type": "string", "const": "no-store" } }
    },
    "schemas": {
      "Region": { "type": "string", "enum": ["West", "Southwest", "Northeast"] },
      "Error": { "type": "object", "required": ["error"], "additionalProperties": false, "properties": { "error": { "type": "string" } } },
      "FilterError": { "type": "object", "required": ["code", "parameter", "error"], "properties": {
        "code": { "type": "string", "enum": ["repeated_filter", "invalid_filter_value", "unknown_parameter"] },
        "parameter": { "type": "string", "description": "Name of the offending query parameter." }, "error": { "type": "string" }
      } },
      "NearbySite": { "type": "object", "required": ["slug", "distanceKm"], "additionalProperties": false, "properties": {
        "slug": { "type": "string" }, "distanceKm": { "type": "integer", "minimum": 0, "description": "Great-circle distance rounded to the nearest kilometer." }
      } },
      "SiteIdentity": { "type": "object", "required": ["code", "slug", "name"], "properties": {
        "code": { "type": "string" }, "slug": { "type": "string" }, "name": { "type": "string" }
      } },
      "SiteFields": {
        "allOf": [{ "$ref": "#/components/schemas/SiteIdentity" }],
        "required": ["state", "region", "image", "imageAlt", "viewpoint", "coordinates", "sourceUrl"],
        "properties": {
          "state": { "type": "string" }, "region": { "$ref": "#/components/schemas/Region" },
          "image": { "type": "string", "format": "uri-reference" }, "imageAlt": { "type": "string" },
          "viewpoint": { "type": "string" }, "coordinates": { "type": "string", "examples": ["34.011° N, 116.168° W"] },
          "sourceUrl": { "type": "string", "format": "uri" }
        }
      },
      "SiteSummary": { "$ref": "#/components/schemas/SiteFields", "unevaluatedProperties": false },
      "Site": { "$ref": "#/components/schemas/SiteFields", "required": ["description", "notes"], "properties": {
        "description": { "type": "string" }, "notes": { "type": "array", "items": { "type": "string" } }
      } },
      "CatalogSummary": { "type": "object", "required": ["total", "byState", "byRegion"], "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "byState": { "type": "object", "description": "Counts keyed by matching state name.", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "byRegion": { "type": "object", "description": "Counts keyed by matching region name.", "propertyNames": { "$ref": "#/components/schemas/Region" }, "additionalProperties": { "type": "integer", "minimum": 1 } }
      } },
      "SitesCsv": { "type": "string", "description": "UTF-8 CSV with code,slug,name columns and CRLF row endings." },
      "FeatureCollection": { "type": "object", "required": ["type", "features"], "properties": {
        "type": { "const": "FeatureCollection" },
        "features": { "type": "array", "items": { "type": "object", "required": ["type", "geometry", "properties"], "properties": {
          "type": { "const": "Feature" },
          "geometry": { "type": "object", "required": ["type", "coordinates"], "properties": {
            "type": { "const": "Point" },
            "coordinates": { "type": "array", "description": "Longitude followed by latitude, in signed decimal degrees.", "minItems": 2, "maxItems": 2,
              "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }] }
          } },
          "properties": { "$ref": "#/components/schemas/SiteIdentity" }
        } } }
      } }
    }
  }
}
