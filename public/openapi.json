{
  "openapi": "3.1.1",
  "info": { "title": "Night Atlas API", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "Catalog", "description": "Browse the site catalog, inspect its response headers, and check catalog status." },
    { "name": "Discovery", "description": "Find nearby observing sites and summarize matching sites by state or region." },
    { "name": "Exports", "description": "Discover export formats and download the catalog as CSV or GeoJSON." }
  ],
  "paths": {
    "/api/nearby": {
      "get": {
        "operationId": "getNearbySites",
        "tags": ["Discovery"],
        "summary": "Find the nearest catalog sites",
        "parameters": [
          { "name": "lat", "in": "query", "required": true, "description": "Latitude in degrees.", "schema": { "type": "number", "minimum": -90, "maximum": 90 } },
          { "name": "lon", "in": "query", "required": true, "description": "Longitude in degrees.", "schema": { "type": "number", "minimum": -180, "maximum": 180 } },
          { "name": "limit", "in": "query", "required": false, "description": "Maximum results; defaults to the current catalog size, which is also the upper bound.", "schema": { "type": "integer", "minimum": 1, "maximum": 6, "default": 6 } },
          { "name": "radius_km", "in": "query", "required": false, "description": "Maximum unrounded great-circle distance in kilometers, inclusive. Specify at most once.", "schema": { "type": "number", "exclusiveMinimum": 0 } },
          { "name": "view", "in": "query", "required": false, "description": "Specify identity exactly once to include catalog code and name. Omit for slug and distance only.", "schema": { "type": "string", "enum": ["identity"] } },
          { "name": "state", "in": "query", "required": false, "description": "Exact, case-sensitive, untrimmed full state name. Specify at most once; repeated state parameters return HTTP 400. An unmatched value returns no sites.", "schema": { "type": "string" } },
          { "name": "exclude", "in": "query", "required": false, "description": "Omit the site whose slug exactly matches this case-sensitive, untrimmed value before applying limit. Blank or unmatched values exclude nothing. Specify at most once; repeated exclude parameters return HTTP 400.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Sites sorted by ascending distance before rounding to whole kilometers.", "content": { "application/json": { "schema": {
            "type": "object", "required": ["sites"], "properties": { "sites": { "type": "array", "items": { "oneOf": [{ "$ref": "#/components/schemas/NearbySite" }, { "$ref": "#/components/schemas/NearbySiteIdentity" }] } } }
          } } } },
          "400": { "description": "Missing or invalid coordinates, invalid limit, radius_km or view, or repeated or unknown query parameter.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/sites": {
      "get": {
        "operationId": "listSites",
        "tags": ["Catalog"],
        "summary": "List or export a filtered page of sites",
        "externalDocs": {
          "description": "Learn how to filter, paginate, and cache catalog requests.",
          "url": "/guides/catalog-http.md"
        },
        "description": "JSON by default. Send Accept: text/csv to select CSV; the entire header must equal text/csv ignoring case. Lists and quality values do not select CSV. The view parameter only changes JSON fields.",
        "parameters": [
          { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/CatalogRegion" },
          { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" },
          { "$ref": "#/components/parameters/View" }, { "$ref": "#/components/parameters/IfNoneMatch" },
          { "$ref": "#/components/parameters/CatalogState" }
        ],
        "responses": {
          "200": {
            "description": "Matching page in catalog order, possibly empty.",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Vary": { "$ref": "#/components/headers/Vary" }, "X-Total-Count": { "$ref": "#/components/headers/Total" }, "Link": { "$ref": "#/components/headers/Next" } },
            "content": {
              "application/json": { "schema": { "type": "object", "required": ["sites"], "properties": { "sites": { "type": "array", "items": { "oneOf": [{ "$ref": "#/components/schemas/Site" }, { "$ref": "#/components/schemas/SiteSummary" }] } } } } },
              "text/csv": { "schema": { "$ref": "#/components/schemas/SitesCsv" } }
            }
          },
          "304": { "description": "The selected representation matches If-None-Match. No body.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Vary": { "$ref": "#/components/headers/Vary" }, "X-Total-Count": { "$ref": "#/components/headers/Total" }, "Link": { "$ref": "#/components/headers/Next" } } },
          "400": { "description": "Invalid filter or repeated or unknown query parameter; always JSON, even when CSV is requested.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "head": {
        "operationId": "headSites",
        "tags": ["Catalog"],
        "summary": "Inspect catalog page headers without downloading the page",
        "description": "Uses the same validation and negotiation as GET. Content-Type is text/csv; charset=utf-8 when Accept equals text/csv ignoring case, and application/json otherwise or on invalid input.",
        "parameters": [
          { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/CatalogRegion" },
          { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Offset" },
          { "$ref": "#/components/parameters/View" }, { "$ref": "#/components/parameters/IfNoneMatch" },
          { "$ref": "#/components/parameters/CatalogState" }
        ],
        "responses": {
          "200": { "description": "Headers for the selected catalog page. No body.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Vary": { "$ref": "#/components/headers/Vary" }, "X-Total-Count": { "$ref": "#/components/headers/Total" }, "Link": { "$ref": "#/components/headers/Next" } } },
          "304": { "description": "The selected representation matches If-None-Match. No body.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Vary": { "$ref": "#/components/headers/Vary" }, "X-Total-Count": { "$ref": "#/components/headers/Total" }, "Link": { "$ref": "#/components/headers/Next" } } },
          "400": { "description": "Invalid filter or repeated or unknown query parameter. No body." }
        }
      }
    },
    "/api/sites/{slug}": {
      "get": {
        "operationId": "getSite",
        "tags": ["Catalog"],
        "summary": "Get one catalog site by its published slug",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "description": "Exact, case-sensitive catalog slug.", "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/View" }
        ],
        "responses": {
          "200": { "description": "One complete catalog site by default, or one summary without description or notes when view=summary.", "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/Site" }, { "$ref": "#/components/schemas/SiteSummary" }] } } } },
          "400": { "description": "Invalid or repeated view parameter.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Site not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/sites.csv": {
      "get": {
        "operationId": "exportSitesCsv",
        "tags": ["Exports"],
        "summary": "Download the catalog as CSV",
        "externalDocs": {
          "description": "Compare the available catalog export formats.",
          "url": "/guides/catalog-formats.md"
        },
        "parameters": [{ "$ref": "#/components/parameters/ExportRegion" }, { "$ref": "#/components/parameters/CatalogState" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": { "200": {
          "description": "CSV attachment, with a header row even when no sites match.",
          "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Content-Disposition": { "schema": { "type": "string", "const": "attachment; filename=\"sites.csv\"" } } },
          "content": { "text/csv": { "schema": { "$ref": "#/components/schemas/SitesCsv" } } }
        }, "304": { "description": "The selected representation matches If-None-Match. No body.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } } }, "400": { "description": "Repeated state parameter: Use the state filter only once.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
      }
    },
    "/api/sites.geojson": {
      "get": {
        "operationId": "exportSitesGeoJson",
        "tags": ["Exports"],
        "summary": "Export catalog viewing spots as GeoJSON points",
        "externalDocs": {
          "description": "Compare the available catalog export formats.",
          "url": "/guides/catalog-formats.md"
        },
        "parameters": [{ "$ref": "#/components/parameters/ExportRegion" }, { "$ref": "#/components/parameters/CatalogState" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": { "200": { "description": "Feature collection, with an empty features array when no sites match.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/geo+json": { "schema": { "$ref": "#/components/schemas/FeatureCollection" } } } }, "304": { "description": "The selected representation matches If-None-Match. No body.", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } } }, "400": { "description": "Repeated state parameter: Use the state filter only once.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
      }
    },
    "/api/sites.ndjson": {
      "get": {
        "operationId": "exportSitesNdjson",
        "tags": ["Exports"],
        "summary": "Export catalog sites as newline-delimited JSON",
        "externalDocs": {
          "description": "Compare the available catalog export formats.",
          "url": "/guides/catalog-formats.md"
        },
        "parameters": [
          { "$ref": "#/components/parameters/IfNoneMatch" },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Exact case-sensitive state name. Unknown or empty values match no sites. Use this parameter only once.",
            "schema": { "type": "string" }
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "description": "Set to 1 to download the catalog as an attachment. If omitted or set to 0, the response is inline.",
            "schema": { "type": "string", "enum": ["0", "1"] }
          }
        ],
        "responses": {
          "200": {
            "description": "UTF-8 text with one compact Site object per line in catalog order, including a final LF. No enclosing array.",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETag" },
              "Content-Disposition": {
                "description": "Present only when download=1.",
                "schema": { "type": "string" },
                "example": "attachment; filename=\"night-atlas-sites.ndjson\""
              }
            },
            "content": { "application/x-ndjson": { "schema": { "type": "string" } } }
          },
          "304": {
            "description": "The selected representation matches If-None-Match. No body.",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }
          },
          "400": {
            "description": "Repeated state parameter.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/sites/exports": {
      "get": {
        "operationId": "listSiteExports",
        "tags": ["Exports"],
        "summary": "Discover catalog export formats",
        "externalDocs": {
          "description": "Compare the available catalog export formats.",
          "url": "/guides/catalog-formats.md"
        },
        "responses": { "200": { "description": "Available formats with their API paths and media types.", "content": { "application/json": { "schema": {
          "type": "object", "required": ["catalog", "formats"], "properties": {
            "catalog": { "const": "night-atlas" },
            "formats": { "type": "array", "items": { "type": "object", "required": ["id", "path", "media_type"], "properties": {
              "id": { "type": "string", "enum": ["json", "csv", "geojson", "ndjson"] },
              "path": { "type": "string", "format": "uri-reference" },
              "media_type": { "type": "string", "enum": ["application/json", "text/csv", "application/geo+json", "application/x-ndjson"] }
            } } }
          }
        } } } } }
      }
    },
    "/api/sites/status": {
      "get": {
        "operationId": "getSiteStatus",
        "tags": ["Catalog"],
        "summary": "Read the current catalog status",
        "responses": { "200": { "description": "Catalog identifier, site count, distinct state count, distinct region count, and timestamp generated for this request.", "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } }, "content": { "application/json": { "schema": {
          "type": "object", "required": ["catalog", "site_count", "state_count", "region_count", "generated_at"], "properties": {
            "catalog": { "const": "night-atlas" }, "site_count": { "type": "integer", "minimum": 0 }, "state_count": { "type": "integer", "minimum": 0, "description": "Number of distinct U.S. state names across the complete catalog. Each state counts once regardless of how many sites it has." }, "region_count": { "type": "integer", "minimum": 0, "description": "Number of distinct region values across the complete catalog." }, "generated_at": { "type": "string", "format": "date-time" }
          }
        } } } } }
      }
    },
    "/api/sites/summary": {
      "get": {
        "operationId": "getSiteSummary",
        "tags": ["Discovery"],
        "summary": "Count matching sites by state and region",
        "externalDocs": {
          "description": "See how filters affect counts by state and region.",
          "url": "/guides/catalog-summary.md"
        },
        "parameters": [
          { "$ref": "#/components/parameters/Search" },
          { "name": "state", "in": "query", "required": false, "description": "Exact case-sensitive state name. Unknown or empty values match no sites.", "schema": { "type": "string" } },
          { "name": "region", "in": "query", "required": false, "description": "Exact case-sensitive catalog region.", "schema": { "$ref": "#/components/schemas/Region" } }
        ],
        "responses": {
          "200": {
            "description": "Counts from the intersection of the supplied filters. No matches yield zero and empty count maps.",
            "headers": {
              "Link": {
                "description": "Links to the catalog summary guide using the help relation.",
                "schema": { "type": "string" },
                "example": "</guides/catalog-summary.md>; rel=\"help\""
              }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogSummary" } } }
          },
          "400": { "description": "Repeated filter, unknown query parameter, invalid region, or search text exceeding the limit.", "headers": { "Cache-Control": { "$ref": "#/components/headers/NoStore" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FilterError" } } } }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CatalogState": { "name": "state", "in": "query", "required": false, "description": "Exact, case-sensitive state name without trimming. Omit to match any state. Empty, unknown, wrong-case, or padded values match no sites. Specify at most once.", "schema": { "type": "string" } },
      "Search": {
        "name": "q", "in": "query", "required": false,
        "description": "Search text limited to 80 UTF-16 code units after JavaScript String.trim() removes outer whitespace. Supplementary Unicode characters (including many emoji) count as two units. Each whitespace-separated word must match a substring in name, state or viewpoint, ignoring case. Empty text adds no restriction.",
        "schema": {
          "type": "string",
          "$comment": "The base pattern limits the trimmed span to 80 regex characters. In Unicode mode, each supplementary code point adds one more UTF-16 unit. Reject combinations of at least k supplementary code points and at least 81-k total code points. Checking k=40 also covers all larger k. In non-Unicode mode the base pattern already counts UTF-16 units.",
          "pattern": "^\\s*(?:\\S(?:[\\s\\S]{0,78}\\S)?)?\\s*$",
          "allOf": [
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){1})[\\s\\S]{79}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){2})[\\s\\S]{78}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){3})[\\s\\S]{77}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){4})[\\s\\S]{76}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){5})[\\s\\S]{75}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){6})[\\s\\S]{74}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){7})[\\s\\S]{73}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){8})[\\s\\S]{72}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){9})[\\s\\S]{71}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){10})[\\s\\S]{70}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){11})[\\s\\S]{69}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){12})[\\s\\S]{68}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){13})[\\s\\S]{67}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){14})[\\s\\S]{66}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){15})[\\s\\S]{65}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){16})[\\s\\S]{64}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){17})[\\s\\S]{63}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){18})[\\s\\S]{62}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){19})[\\s\\S]{61}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){20})[\\s\\S]{60}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){21})[\\s\\S]{59}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){22})[\\s\\S]{58}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){23})[\\s\\S]{57}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){24})[\\s\\S]{56}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){25})[\\s\\S]{55}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){26})[\\s\\S]{54}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){27})[\\s\\S]{53}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){28})[\\s\\S]{52}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){29})[\\s\\S]{51}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){30})[\\s\\S]{50}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){31})[\\s\\S]{49}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){32})[\\s\\S]{48}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){33})[\\s\\S]{47}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){34})[\\s\\S]{46}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){35})[\\s\\S]{45}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){36})[\\s\\S]{44}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){37})[\\s\\S]{43}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){38})[\\s\\S]{42}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){39})[\\s\\S]{41}\\s*\\S)" },
            { "pattern": "^\\s*(?!\\s)(?!(?=(?:[\\u0000-\\uFFFF]*[^\\u0000-\\uFFFF]){40})[\\s\\S]{40}\\s*\\S)" }
          ]
        }
      },
      "CatalogRegion": { "name": "region", "in": "query", "required": false, "description": "West, Southwest or Northeast, ignoring case and outer whitespace. Empty or unmatched values are invalid.", "schema": { "type": "string", "pattern": "^\\s*(?:[Ww][Ee][Ss][Tt]|[Ss][Oo][Uu][Tt][Hh][Ww][Ee][Ss][Tt]|[Nn][Oo][Rr][Tt][Hh][Ee][Aa][Ss][Tt])\\s*$" } },
      "ExportRegion": { "name": "region", "in": "query", "required": false, "style": "form", "explode": true, "description": "One occurrence filters by region ignoring case and outer whitespace; an empty or unmatched value returns no sites. Omission or multiple occurrences impose no region restriction. When state is supplied, both filters must match. Unrelated query parameters are ignored.", "schema": { "type": "array", "items": { "type": "string" } }, "example": ["West"] },
      "Limit": { "name": "limit", "in": "query", "required": false, "description": "Maximum page size, written as decimal digits without leading zeros. Omit to return all remaining matches.", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
      "Offset": { "name": "offset", "in": "query", "required": false, "description": "Number of matching sites to skip, written as unsigned decimal digits.", "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0 } },
      "View": { "name": "view", "in": "query", "required": false, "description": "Use summary to omit description and notes from JSON records. Omit for full records.", "schema": { "type": "string", "const": "summary" } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "description": "Use * or a comma-separated entity-tag list. A weak comparison against the selected representation determines whether to return 304.", "schema": { "type": "string" } }
    },
    "headers": {
      "ETag": { "description": "Weak validator for the selected response bytes.", "schema": { "type": "string" } },
      "Vary": { "schema": { "type": "string", "const": "Accept" } },
      "Total": { "description": "Total matching sites before pagination.", "schema": { "type": "integer", "minimum": 0 } },
      "Next": { "description": "Relative next-page link with rel=next, present only when a limit was supplied and more matches remain.", "schema": { "type": "string" } },
      "NoStore": { "schema": { "type": "string", "const": "no-store" } }
    },
    "schemas": {
      "Region": { "type": "string", "enum": ["West", "Southwest", "Northeast"] },
      "Error": { "type": "object", "required": ["error"], "additionalProperties": false, "properties": { "error": { "type": "string" } } },
      "FilterError": { "type": "object", "required": ["code", "parameter", "error"], "properties": {
        "code": { "type": "string", "enum": ["repeated_filter", "invalid_filter_value", "unknown_parameter"] },
        "parameter": { "type": "string", "description": "Name of the offending query parameter." }, "error": { "type": "string" }
      } },
      "NearbySite": { "type": "object", "required": ["slug", "distanceKm"], "additionalProperties": false, "properties": {
        "slug": { "type": "string" }, "distanceKm": { "type": "integer", "minimum": 0, "description": "Great-circle distance rounded to the nearest kilometer." }
      } },
      "SiteIdentity": { "type": "object", "required": ["code", "slug", "name"], "properties": {
        "code": { "type": "string" }, "slug": { "type": "string" }, "name": { "type": "string" }
      } },
      "NearbySiteIdentity": {
        "allOf": [{ "$ref": "#/components/schemas/SiteIdentity" }],
        "required": ["distanceKm"],
        "properties": { "distanceKm": { "type": "integer", "minimum": 0, "description": "Great-circle distance rounded to the nearest kilometer." } },
        "unevaluatedProperties": false
      },
      "SiteFields": {
        "allOf": [{ "$ref": "#/components/schemas/SiteIdentity" }],
        "required": ["state", "region", "image", "imageAlt", "viewpoint", "coordinates", "sourceUrl"],
        "properties": {
          "state": { "type": "string" }, "region": { "$ref": "#/components/schemas/Region" },
          "image": { "type": "string", "format": "uri-reference" }, "imageAlt": { "type": "string" },
          "viewpoint": { "type": "string" }, "coordinates": { "type": "string", "examples": ["34.011° N, 116.168° W"] },
          "sourceUrl": { "type": "string", "format": "uri" }
        }
      },
      "SiteSummary": { "$ref": "#/components/schemas/SiteFields", "unevaluatedProperties": false },
      "Site": { "$ref": "#/components/schemas/SiteFields", "required": ["description", "notes"], "properties": {
        "description": { "type": "string" }, "notes": { "type": "array", "items": { "type": "string" } }
      } },
      "CatalogSummary": { "type": "object", "required": ["total", "byState", "byRegion"], "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "byState": { "type": "object", "description": "Counts keyed by matching state name.", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "byRegion": { "type": "object", "description": "Counts keyed by matching region name.", "propertyNames": { "$ref": "#/components/schemas/Region" }, "additionalProperties": { "type": "integer", "minimum": 1 } }
      } },
      "SitesCsv": { "type": "string", "description": "UTF-8 CSV with code,slug,name columns and CRLF row endings." },
      "FeatureCollection": { "type": "object", "required": ["type", "features"], "properties": {
        "type": { "const": "FeatureCollection" },
        "features": { "type": "array", "items": { "type": "object", "required": ["type", "geometry", "properties"], "properties": {
          "type": { "const": "Feature" },
          "geometry": { "type": "object", "required": ["type", "coordinates"], "properties": {
            "type": { "const": "Point" },
            "coordinates": { "type": "array", "description": "Longitude followed by latitude, in signed decimal degrees.", "minItems": 2, "maxItems": 2,
              "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }] }
          } },
          "properties": { "$ref": "#/components/schemas/SiteIdentity" }
        } } }
      } }
    }
  }
}
