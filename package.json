{
  "name": "night-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "A dark-sky field guide built with the Next.js App Router.",
  "engines": {
    "node": "^24.11.0 || ^26.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "format": "biome format --write ."
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
